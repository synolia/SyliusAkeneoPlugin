{
    "name": "synolia/sylius-akeneo-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "akeneo",
        "connector",
        "symfony-ux"
    ],
    "description": "Akeneo connector for Sylius.",
    "license": "EUPL-1.2",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "akeneo/api-php-client": ">=8.0 <12.0",
        "behat/transliterator": "^1.3",
        "doctrine/dbal": "^3.9 || ^4.0",
        "doctrine/doctrine-bundle": "^2.0 || ^3.0",
        "http-interop/http-factory-guzzle": "^1.2",
        "league/pipeline": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "sylius/sylius": "^2.2",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/lock": "^7.4 || ^8.0",
        "symfony/property-access": "^7.4 || ^8.0",
        "symfony/property-info": "^7.4 || ^8.0",
        "symfony/serializer": "^7.4 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "donatj/mock-webserver": "^2.10",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpmd/phpmd": "^3.0",
        "phpro/grumphp": "^2.27",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0",
        "povils/phpmnd": "^3.6",
        "rector/rector": "^2.9",
        "seld/jsonlint": "^1.12",
        "squizlabs/php_codesniffer": "^3.13",
        "sylius-labs/coding-standard": "^4.5",
        "sylius/test-application": "^2.2@alpha",
        "symfony/browser-kit": "^7.4 || ^8.0",
        "symfony/css-selector": "^7.4 || ^8.0"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Synolia\\SyliusAkeneoPlugin\\": "src/",
            "Synolia\\SyliusAkeneoPlugin\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Synolia\\SyliusAkeneoPlugin\\TestApplication\\": "tests/TestApplication/src/",
            "Tests\\Synolia\\SyliusAkeneoPlugin\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "php bin/create_node_symlink.php"
        ]
    },
    "extra": {
        "public-dir": "vendor/sylius/test-application/public"
    }
}
