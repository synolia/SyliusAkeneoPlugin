includes:
    - phpstan-baseline.neon

parameters:
    level: max
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    paths:
        - ../src
    bootstrapFiles:
        - ../vendor/autoload.php
    excludePaths:
        - ../bin
        - ../tests
    ignoreErrors:
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        # Plugin-specific ignores (with a comment explaining why) go below this line
        # Sylius 2.2 reports the type as Sylius\Resource\Model\ResourceInterface, Sylius 2.3 as its
        # Sylius\Component\Resource\Model\ResourceInterface alias: the generated baseline only matches the latter
        -
            message: '#^Parameter \#1 \$model of method Synolia\\SyliusAkeneoPlugin\\Processor\\ProductAttribute\\AbstractModelAkeneoAttributeProcessor\:\:setValueToMethod\(\) expects Sylius\\Resource\\Model\\ResourceInterface, mixed given\.$#'
            identifier: argument.type
            path: ../src/Processor/ProductAttribute/AbstractModelAkeneoAttributeProcessor.php
